<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Fitness Tracker</AssemblyName>
    <RootNamespace>FitnessTracker</RootNamespace>
    <ApplicationIcon>Assets/FitnessTracker.ico</ApplicationIcon>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Output stays beside the saved history in bin/Debug/net8.0, where the desktop shortcut points. -->
    <OutputPath>bin/$(Configuration)/net8.0/</OutputPath>
  </PropertyGroup>
  <ItemGroup><Compile Remove="Checks/**/*.cs" /></ItemGroup>
  <ItemGroup><Resource Include="Assets/FitnessTracker.ico" /></ItemGroup>
</Project>
