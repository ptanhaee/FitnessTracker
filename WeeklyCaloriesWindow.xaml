<Window x:Class="FitnessTracker.WeeklyCaloriesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FitnessTracker"
        Style="{StaticResource {x:Type Window}}" Title="Fitness Tracker · Weekly calories"
        Width="1100" Height="980" MinWidth="900" MinHeight="840" WindowStartupLocation="CenterOwner">
  <Grid Margin="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <DockPanel>
      <Button Content="Close" DockPanel.Dock="Right" Style="{StaticResource QuietButton}" Click="CloseWindow" VerticalAlignment="Center"/>
      <TextBlock Text="Weekly calories" FontSize="26" FontWeight="SemiBold"/>
    </DockPanel>
    <StackPanel Grid.Row="1" Margin="0,8,0,16">
      <TextBlock Text="Monday–Sunday · Newest weeks first · Current week is through today" Style="{StaticResource Muted}"/>
      <TextBlock Text="Daily average uses calendar days (7 for past weeks). Logged days shows how complete each week is." Style="{StaticResource Muted}"/>
      <TextBlock Text="Estimates use 7,700 kcal/kg. Undated starting balances are excluded." Style="{StaticResource Muted}"/>
    </StackPanel>
    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,18">
      <StackPanel>
        <TextBlock x:Name="ChartRange" FontWeight="SemiBold"/>
        <TextBlock FontSize="12" Margin="0,6,0,0"><Run Text="● Deficit (+)    " Foreground="{DynamicResource AccentBrush}"/><Run Text="● Surplus (−)    " Foreground="{DynamicResource NegativeBrush}"/><Run Text="Hover for weekly details" Foreground="{DynamicResource MutedBrush}"/></TextBlock>
        <local:FitnessChart x:Name="WeeklyPlot" Kind="WeeklyCalories" Height="320" Margin="0,4,0,0" Cursor="Arrow" AutomationProperties.Name="Weekly net calorie totals for the displayed weeks"/>
      </StackPanel>
    </Border>
    <Grid Grid.Row="3" Margin="12,0,22,10">
      <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="0.8*"/><ColumnDefinition Width="1.8*"/></Grid.ColumnDefinitions>
      <TextBlock Text="WEEK" Style="{StaticResource Muted}" FontSize="10"/>
      <TextBlock Grid.Column="1" Text="NET KCAL" Style="{StaticResource Muted}" FontSize="10" TextAlignment="Right"/>
      <TextBlock Grid.Column="2" Text="AVG / DAY" Style="{StaticResource Muted}" FontSize="10" TextAlignment="Right"/>
      <TextBlock Grid.Column="3" Text="LOGGED DAYS" Style="{StaticResource Muted}" FontSize="10" TextAlignment="Right"/>
      <TextBlock Grid.Column="4" Text="EST. WEIGHT CHANGE" Style="{StaticResource Muted}" FontSize="10" TextAlignment="Right"/>
    </Grid>
    <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl x:Name="WeeksList" Margin="0,0,10,0">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border BorderBrush="{DynamicResource RowDividerBrush}" BorderThickness="0,0,0,1" Padding="12,10">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="0.8*"/><ColumnDefinition Width="1.8*"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="{Binding DateText}" TextWrapping="Wrap"/><TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" FontSize="11"/></StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding TotalText}" Foreground="{Binding Color}" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding AverageText}" TextAlignment="Right" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="3" Text="{Binding LoggedText}" Foreground="{DynamicResource MutedBrush}" TextAlignment="Right" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="4" Text="{Binding WeightText}" TextAlignment="Right" TextWrapping="Wrap" VerticalAlignment="Center" Margin="10,0,0,0"/>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
    <TextBlock Grid.Row="4" x:Name="EmptyMessage" Text="No weekly history yet. Log a calorie entry to see your weeks here." Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    <DockPanel Grid.Row="5" Margin="0,16,0,0">
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
        <Button x:Name="NewerButton" Content="← Newer" Style="{StaticResource QuietButton}" Click="NewerWeeks" Margin="0,0,8,0"/>
        <Button x:Name="OlderButton" Content="Older →" Style="{StaticResource QuietButton}" Click="OlderWeeks"/>
      </StackPanel>
      <TextBlock x:Name="PageLabel" Style="{StaticResource Muted}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
    </DockPanel>
  </Grid>
</Window>
