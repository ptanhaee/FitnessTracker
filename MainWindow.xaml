<Window x:Class="FitnessTracker.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:FitnessTracker" Style="{StaticResource {x:Type Window}}" Title="Fitness Tracker" Width="1440" Height="960" MinWidth="1100" MinHeight="700" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <ContextMenu x:Key="HistoryEntryMenu" x:Shared="False" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
      <MenuItem Header="_Edit entry…" Click="EditHistoryEntry"/>
      <MenuItem Header="_Delete entry…" Foreground="{DynamicResource NegativeBrush}" Click="DeleteHistoryEntry"/>
    </ContextMenu>
  </Window.Resources>
  <Grid Margin="28,22,22,14">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,22">
      <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock x:Name="TodayLabel" HorizontalAlignment="Right" FontSize="14"/><TextBlock Text="YOUR PERSONAL FITNESS JOURNAL" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,6,0,0"/></StackPanel>
      <StackPanel><StackPanel Orientation="Horizontal"><Border Background="{DynamicResource AccentBrush}" Width="6" CornerRadius="3" Margin="0,3,12,3"/><TextBlock Text="Fitness Tracker" FontSize="29" FontWeight="SemiBold"/></StackPanel><TextBlock Text="Small steps. A clearer picture of your progress." Style="{StaticResource Muted}" Margin="18,5,0,0"/></StackPanel>
    </DockPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="284"/></Grid.ColumnDefinitions>
      <ScrollViewer x:Name="DashboardScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
        <StackPanel>
          <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="THIS WEEK" Style="{StaticResource Muted}"/><TextBlock x:Name="ThisWeekValue" FontSize="27" FontWeight="SemiBold" Margin="0,6,0,3"/><TextBlock x:Name="ThisWeekAverage" Style="{StaticResource Muted}"/><TextBlock x:Name="ThisWeekWeight" Style="{StaticResource Muted}" Margin="0,4,0,0"/><TextBlock x:Name="ThisWeekDates" Style="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel></Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><DockPanel><Button Content="Expand ↗" DockPanel.Dock="Right" Style="{StaticResource QuietButton}" Click="ExpandWeeklyCalories" AutomationProperties.Name="Expand weekly calorie history"/><TextBlock Text="LAST WEEK" Style="{StaticResource Muted}" VerticalAlignment="Center"/></DockPanel><TextBlock x:Name="LastWeekValue" FontSize="27" FontWeight="SemiBold" Margin="0,6,0,3"/><TextBlock x:Name="LastWeekAverage" Style="{StaticResource Muted}"/><TextBlock x:Name="LastWeekWeight" Style="{StaticResource Muted}" Margin="0,4,0,0"/><TextBlock x:Name="LastWeekDates" Style="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel></Border>
            <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="TOTAL NET DEFICIT" Style="{StaticResource Muted}"/><TextBlock x:Name="TotalValue" FontSize="27" FontWeight="SemiBold" Margin="0,6,0,3"/><TextBlock x:Name="TotalWeight" Style="{StaticResource Muted}"/><TextBlock x:Name="TrackedAverage" Style="{StaticResource Muted}" Margin="0,4,0,0"/><TextBlock x:Name="TrackingSince" Style="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel></Border>
          </Grid>
          <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,8,0"><StackPanel>
              <DockPanel><Button DockPanel.Dock="Right" Content="Expand ↗" Style="{StaticResource QuietButton}" Click="ExpandWeight" AutomationProperties.Name="Expand weight chart"/><TextBlock Text="Weight trend" Style="{StaticResource Heading}" VerticalAlignment="Center"/></DockPanel>
              <TextBlock Margin="0,10,0,0" FontSize="11"><Run Text="● L weigh-in   " Foreground="{DynamicResource LowBrush}"/><Run Text="– –●– – Weekly average" Foreground="{DynamicResource WeeklyAverageBrush}"/></TextBlock>
              <local:FitnessChart x:Name="WeightPlot" Kind="Weight" Height="238" Margin="-6,4,-4,0" AutomationProperties.Name="Weight trend chart. Press Enter to expand."/>
              <TextBlock Text="Weekly averages use the last weigh-in on each recorded day." Style="{StaticResource Muted}" FontSize="11"/>
            </StackPanel></Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="18" Margin="8,0,0,0"><StackPanel>
              <DockPanel><Button DockPanel.Dock="Right" Content="Expand ↗" Style="{StaticResource QuietButton}" Click="ExpandCalories" AutomationProperties.Name="Expand daily calorie chart"/><TextBlock Text="Daily balance" Style="{StaticResource Heading}" VerticalAlignment="Center"/></DockPanel>
              <TextBlock Margin="0,10,0,0" FontSize="11"><Run Text="● Deficit  " Foreground="{DynamicResource AccentBrush}"/><Run Text="● Surplus  " Foreground="{DynamicResource NegativeBrush}"/><Run Text="Last 14 days" Foreground="{DynamicResource MutedBrush}"/></TextBlock>
              <local:FitnessChart x:Name="CaloriePlot" Kind="Calories" Height="238" Margin="-6,4,-4,0" AutomationProperties.Name="Daily balance chart. Press Enter to expand."/>
              <TextBlock Text="Positive = deficit · Negative = surplus · Hover for details" Style="{StaticResource Muted}" FontSize="11"/>
            </StackPanel></Border>
          </Grid>
          <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,16"><StackPanel>
            <DockPanel><Button DockPanel.Dock="Right" Content="Expand ↗" Style="{StaticResource QuietButton}" Click="ExpandProgress" AutomationProperties.Name="Expand cumulative progress chart"/><TextBlock Text="The bigger picture" Style="{StaticResource Heading}" VerticalAlignment="Center"/></DockPanel>
            <TextBlock Text="Cumulative net deficit · All recorded days, including your starting balance" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
            <local:FitnessChart x:Name="ProgressPlot" Kind="Progress" Height="180" Margin="-6,4,-4,0" AutomationProperties.Name="Cumulative progress chart. Press Enter to expand."/>
            <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="GoalProgressText" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/><TextBlock Grid.Column="1" x:Name="GoalRemainingText" Style="{StaticResource Muted}"/></Grid>
            <Grid Height="5" Margin="0,10,0,0" Background="{DynamicResource ProgressTrackBrush}" SizeChanged="ProgressTrackChanged" x:Name="ProgressTrack"><Border x:Name="ProgressFill" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Left" CornerRadius="2"/></Grid>
            <Button Content="Edit goals" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Click="EditGoals"/>
          </StackPanel></Border>
          <Border Style="{StaticResource Card}" Padding="18"><StackPanel>
            <DockPanel><TextBlock x:Name="HistoryCount" DockPanel.Dock="Right" Style="{StaticResource Muted}" VerticalAlignment="Center"/><TextBlock Text="Entry history" Style="{StaticResource Heading}"/></DockPanel>
            <TextBlock Text="Newest first · 15 per page · Right-click an entry to edit or delete" Style="{StaticResource Muted}" Margin="0,4,0,12"/>
            <Grid Margin="10,0,10,8"><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions><TextBlock Text="DATE" Style="{StaticResource Muted}" FontSize="10"/><TextBlock Grid.Column="1" Text="ENTRY" Style="{StaticResource Muted}" FontSize="10"/><TextBlock Grid.Column="2" Text="VALUE" Style="{StaticResource Muted}" FontSize="10" TextAlignment="Right"/></Grid>
            <ListBox x:Name="HistoryList" Foreground="{DynamicResource TextBrush}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
              <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="ContextMenu" Value="{StaticResource HistoryEntryMenu}"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" Background="Transparent" CornerRadius="5"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource RowSelectedBrush}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource RowHoverBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
              </Style></ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource RowDividerBrush}" BorderThickness="0,0,0,1" Padding="10,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions><TextBlock Text="{Binding DateText}" Foreground="{DynamicResource MutedBrush}"/><TextBlock Grid.Column="1" Text="{Binding Kind}"/><TextBlock Grid.Column="2" Text="{Binding Value}" Foreground="{Binding Color}" TextAlignment="Right" FontWeight="SemiBold"/></Grid></Border></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="EmptyHistory" Text="Your first entry will appear here. Use the forms to get started." Style="{StaticResource Muted}" Visibility="Collapsed"/>
            <DockPanel Margin="0,14,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="PreviousPageButton" Content="← Previous" Style="{StaticResource QuietButton}" Click="PreviousHistoryPage" Margin="0,0,8,0"/><Button x:Name="NextPageButton" Content="Next →" Style="{StaticResource QuietButton}" Click="NextHistoryPage"/></StackPanel><TextBlock x:Name="HistoryPageLabel" Style="{StaticResource Muted}" VerticalAlignment="Center"/></DockPanel>
            <TextBlock x:Name="HistoryStatus" Style="{StaticResource Muted}" Margin="0,8,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
          </StackPanel></Border>
        </StackPanel>
      </ScrollViewer>
      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,6,0">
        <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel>
          <DockPanel><Button Content="Edit" DockPanel.Dock="Right" Style="{StaticResource QuietButton}" Click="EditGoals" AutomationProperties.Name="Edit calorie and weight goals"/><TextBlock Text="Your weight goal" Style="{StaticResource Heading}" VerticalAlignment="Center"/></DockPanel><TextBlock x:Name="GoalWeight" FontSize="34" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock x:Name="GoalWeightNote" Style="{StaticResource Muted}"/>
          <Border Background="{DynamicResource GoalPanelBrush}" CornerRadius="9" Padding="12" Margin="0,14,0,0"><StackPanel><TextBlock x:Name="WeightGoalSummary" TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/><TextBlock x:Name="RequiredDeficit" TextWrapping="Wrap" Margin="0,6,0,0"/><TextBlock Text="Daily deficit estimate from latest L weigh-in; 7,700 kcal/kg." Style="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0"/></StackPanel></Border>
        </StackPanel></Border>
        <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel>
          <TextBlock Text="Log calories" Style="{StaticResource Heading}"/><TextBlock Text="Use + for a deficit, − for a surplus." Style="{StaticResource Muted}" Margin="0,4,0,12"/>
          <Label Target="{Binding ElementName=CalorieInput}" Content="Net calories (kcal)" Foreground="{DynamicResource MutedBrush}" Padding="0,0,0,6"/><TextBox x:Name="CalorieInput" AutomationProperties.Name="Net calories in kcal" ToolTip="Example: 350 for a deficit, -150 for a surplus" KeyDown="CalorieKeyDown"/>
          <Label Target="{Binding ElementName=CalorieDate}" Content="Date · YYYY-MM-DD" Foreground="{DynamicResource MutedBrush}" Padding="0,10,0,6"/><TextBox x:Name="CalorieDate" AutomationProperties.Name="Calorie entry date" KeyDown="CalorieKeyDown"/>
          <Button x:Name="SaveCaloriesButton" Content="Save calorie entry" Click="SaveCalories" Margin="0,14,0,0"/><TextBlock x:Name="CalorieStatus" Style="{StaticResource Muted}" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel></Border>
        <Border Style="{StaticResource Card}"><StackPanel>
          <TextBlock Text="Log a weigh-in" Style="{StaticResource Heading}" Margin="0,0,0,12"/>
          <Label Target="{Binding ElementName=WeightInput}" Content="Weight (kg)" Foreground="{DynamicResource MutedBrush}" Padding="0,0,0,6"/><TextBox x:Name="WeightInput" AutomationProperties.Name="Weight in kilograms" KeyDown="WeightKeyDown"/>
          <Label Target="{Binding ElementName=WeightDate}" Content="Date · YYYY-MM-DD" Foreground="{DynamicResource MutedBrush}" Padding="0,10,0,6"/><TextBox x:Name="WeightDate" AutomationProperties.Name="Weigh-in date" KeyDown="WeightKeyDown"/>
          <Button x:Name="SaveWeightButton" Content="Save weigh-in" Click="SaveWeight" Margin="0,14,0,0"/><TextBlock x:Name="WeightStatus" Style="{StaticResource Muted}" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel></Border>
      </StackPanel></ScrollViewer>
    </Grid>
    <DockPanel Grid.Row="2" Margin="0,10,4,0"><TextBlock Text="●  Saved locally" Foreground="{DynamicResource AccentBrush}" FontSize="11" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="18,0,0,0"/><StackPanel x:Name="PalettePicker" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="Color palette" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/></StackPanel><TextBlock Text="Click any chart to open a larger window. Your dashboard stays available." Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/></DockPanel>
  </Grid>
</Window>
